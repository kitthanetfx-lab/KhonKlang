# ── Appwrite ──────────────────────────────────────────────
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your_project_id
NEXT_PUBLIC_APPWRITE_PROJECT_NAME=khonklang
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── LINE Login ────────────────────────────────────────────
LINE_CHANNEL_ID=your_line_channel_id
LINE_CHANNEL_SECRET=your_line_channel_secret

# ── Appwrite server API key (เก็บเป็นความลับ ห้าม commit) ──
APPWRITE_API_KEY=your_appwrite_server_api_key

# ── SlipOK (ตรวจสลิปโอนเงินอัตโนมัติ) — เก็บเป็นความลับ ──
SLIPOK_BRANCH_ID=your_slipok_branch_id
SLIPOK_API_KEY=your_slipok_api_key
