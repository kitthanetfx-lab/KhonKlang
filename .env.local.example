# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://mwzotvfgzavwkfdmukuv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# server-only — bypasses RLS, never expose to the client, never commit
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Cron (ลบดีลที่อีกฝ่ายไม่เข้าร่วมเกิน 2 วัน) ─────────────
CRON_SECRET=your_random_cron_secret

# ── LINE Login ────────────────────────────────────────────
LINE_CHANNEL_ID=your_line_channel_id
LINE_CHANNEL_SECRET=your_line_channel_secret
# Messaging API (channel เดียวกัน) — แจ้งเตือนทีมแอดมินเมื่อดีลเข้าคิวงาน
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_ADMIN_GROUP_ID=your_line_admin_group_id

# ── SlipOK (ตรวจสลิปโอนเงินอัตโนมัติ) — เก็บเป็นความลับ ──
SLIPOK_BRANCH_ID=your_slipok_branch_id
SLIPOK_API_KEY=your_slipok_api_key

# ── Support Call / WebRTC ──────────────────────────────────
# ล็อก UI โทรไว้ก่อนจนกว่า VPS + coturn จะพร้อมจริง
NEXT_PUBLIC_SUPPORT_CALLS_ENABLED=false
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
WEBRTC_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
# แนะนำใช้ shared secret สำหรับ production
WEBRTC_TURN_SECRET=your_turn_shared_secret
WEBRTC_TURN_TTL_SECONDS=3600
# ถ้าผู้ให้บริการ TURN ให้ username/password แบบคงที่ ให้ใช้ 2 บรรทัดล่างแทน secret
# WEBRTC_TURN_USERNAME=your_turn_username
# WEBRTC_TURN_CREDENTIAL=your_turn_password

# ── Push Notification (Firebase / FCM) ─────────────────────
# ใช้ยิง push ไปแอปมือถือ (Capacitor — กลางฮับ) ทั้ง Android (FCM) และ iOS (ผ่าน FCM → APNs)
# ค่าทั้ง 3 มาจาก Firebase Console → Project settings → Service accounts → generate new private key
# หากยังไม่ใส่: push จะเงียบข้ามไป (แต่ in-app notification ในเว็บยังทำงานปกติ)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email@your_project.iam.gserviceaccount.com
# private key ใน JSON มีบรรทัดใหม่จริง ๆ ใน env ต้องใส่เป็น \\n (backslash n สองตัว) หรือ wrap ด้วย "..."
# ตัวอย่าง: "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=your_firebase_private_key_with_newlines
